    <queries><package android:name="cn.paperforge.app"/></queries>
    <application android:label="PaperForge Office 手机引擎" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <service android:name=".OfficeJobService" android:process=":worker" android:exported="true" android:permission="cn.paperforge.office.permission.CONVERT" />
